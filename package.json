{
  "name": "@faultkey/causallayer-mcp",
  "version": "0.4.0",
  "description": "Model Context Protocol server for CausalLayer \u2014 deterministic AI liability attribution with Bitcoin-anchored, signed certificates. Runs on Cloudflare Workers or locally via npx.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "dist/standalone.js",
  "bin": {
    "causallayer-mcp": "./dist/standalone.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-governance",
    "ai-liability",
    "ai-incident-response",
    "causal-attribution",
    "audit-trail",
    "merkle-tree",
    "ed25519",
    "opentimestamps",
    "cloudflare-workers",
    "deterministic",
    "bitcoin-anchor",
    "insurance",
    "compliance"
  ],
  "homepage": "https://faultkey.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/smq9sn5jck-coder/causallayer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/smq9sn5jck-coder/causallayer-mcp/issues"
  },
  "scripts": {
    "build:npm": "esbuild src/standalone.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/standalone.js --banner:js=\"#!/usr/bin/env node\" --external:@modelcontextprotocol/sdk",
    "prepublishOnly": "pnpm run build:npm",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.12.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@types/node": "^22.7.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.93.0"
  },
  "engines": {
    "node": ">=20"
  },
  "mcpName": "io.github.smq9sn5jck-coder/causallayer",
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.24.3",
      "ws": ">=8.20.1",
      "vite": ">=6.4.2"
    }
  }
}
