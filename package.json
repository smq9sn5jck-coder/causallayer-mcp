{
  "name": "causallayer-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for CausalLayer — deterministic AI liability attribution with Bitcoin-anchored, signed certificates. Runs on Cloudflare Workers.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-governance",
    "ai-liability",
    "ai-incident-response",
    "causal-attribution",
    "audit-trail",
    "merkle-tree",
    "ed25519",
    "opentimestamps",
    "cloudflare-workers"
  ],
  "homepage": "https://github.com/smq9sn5jck-coder/causallayer-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/smq9sn5jck-coder/causallayer-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/smq9sn5jck-coder/causallayer-mcp/issues"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:sandbox": "wrangler deploy --env sandbox",
    "deploy:production": "wrangler deploy --env production",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.12.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6",
    "wrangler": "^4.92.0"
  },
  "engines": {
    "node": ">=20"
  }
}
