{
  // Cloudflare Worker config for faultkey-try-demo
  // Standalone demo Worker - separate from the main causallayer-mcp Worker
  // Auto-deploys on push to main via GitHub integration (Root directory: demo)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faultkey-try-demo",
  "main": "try-worker.js",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  // No routes — the production faultkey.com/try is served by the
  // faultkey-landing React app calling mcp.faultkey.com (the real engine).
  // This Worker stays available only at faultkey-try-demo.workers.dev as
  // a developer-facing engine sandbox, NOT as the primary demo.
}
