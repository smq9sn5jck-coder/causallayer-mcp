{
  // Cloudflare Worker config for faultkey-try-demo
  // Standalone demo Worker - separate from the main causallayer-mcp Worker
  // Auto-deploys on push to main via GitHub integration (Root directory: demo)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faultkey-try-demo",
  "main": "try-worker.js",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "routes": [
    // All demo traffic lives under /try* — single namespace, zero risk of
    // colliding with the main faultkey.com SPA or any other future API routes
    {
      "pattern": "faultkey.com/try",
      "zone_name": "faultkey.com"
    },
    {
      "pattern": "faultkey.com/try/*",
      "zone_name": "faultkey.com"
    }
  ]
}
